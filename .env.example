# Frontend (Vite only exposes variables prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Owner authentication (Edge Function secrets, NOT exposed to the browser).
# Generate a password hash with:
#   node -e "const c=require('crypto');console.log(c.createHash('sha256').update('your-password').digest('hex'))"
# Generate a session secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Then set them in Supabase:
#   supabase secrets set OWNER_PASSWORD_HASH=<sha256-hex> SESSION_SECRET=<base64>
# For local Edge Function development, put them in supabase/functions/.env (gitignored).
